# 이 파일을 .env로 복사한 뒤 필요하면 값을 바꾸세요. 전부 기본값이 있어서 안 바꿔도 동작합니다.
# .env는 .gitignore에 들어있어 git에 올라가지 않습니다.

# LLM_PROVIDER: ollama(기본, 로컬) 또는 openai
LLM_PROVIDER=ollama
# OLLAMA_MODEL: `ollama list`로 확인한 실제 설치된 모델명
OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_HOST: 기본 http://localhost:11434
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
# LLM_PROVIDER=openai로 바꿀 때만 필요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# EMBEDDING_DEVICE: cuda(NVIDIA GPU) 또는 cpu. GPU 없는 팀원 컴퓨터에서는 cpu로 바꿀 것
# (docs/DESIGN.md 개발 기록 (29) 참고 — CPU는 62,000건 임베딩 기준 실측 12시간+,
# 이미 만들어진 벡터DB를 그대로 복사해 쓰는 이 프로젝트에서는 조회 시 재임베딩 비용만 해당)
EMBEDDING_DEVICE=cuda

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_DB=franchise_web
POSTGRES_USER=franchise_user
POSTGRES_PASSWORD=change-me
# 데이터를 처음부터 다시 모을 때만 필요 (scripts/01~02)
# franchise.ftc.go.kr에서 발급한 정보공개서 Open API 키
DISCLOSURE_LIST_SERVICE_KEY=
